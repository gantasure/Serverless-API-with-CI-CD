service: serverless-api-cicd

provider:
  name: aws
  runtime: nodejs18.x
  region: us-east-1 # Change to your region
  iamRoleStatements:
    - Effect: Allow
      Action:
        - logs:CreateLogGroup
        - logs:CreateLogStream
        - logs:PutLogEvents
      Resource: "arn:aws:logs:*:*:*"

functions:
  hello:
    handler: handler.hello
    events:
      - http:
          method: get
          path: hello
